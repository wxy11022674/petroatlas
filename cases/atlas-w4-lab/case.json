      "steps": [
        {
          "name": "生成带标签样本",
          "role": "输入",
          "do": "建立独立训练点和测试点。",
          "effect": "看到三类岩性的特征分布。",
          "trap": "标签是教学构造，非岩心鉴定。"
        },
        {
          "name": "改变噪声与邻居数",
          "role": "处理",
          "do": "调节类别重叠和投票邻域。",
          "effect": "观察决策边界的变化。",
          "trap": "真实电阻率还受流体等因素影响。"
        },
        {
          "name": "预测留出样本",
          "role": "推断",
          "do": "根据训练邻居给测试点分类。",
          "effect": "输出分类与逐类统计。",
          "trap": "测试标签只用于验收。"
        },
        {
          "name": "核查混淆来源",
          "role": "验证",
          "do": "对照误分点与类别交界。",
          "effect": "理解特征不足造成的不可分性。",
          "trap": "高合成准确率不能外推到新井。"
        }
