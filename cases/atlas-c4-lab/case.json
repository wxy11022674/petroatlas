      "steps": [
        {
          "name": "建立几何真值",
          "role": "输入",
          "do": "计算圆形井眼与偏心套管的周向间隙。",
          "effect": "给出最小间隙和真实偏心率。",
          "trap": "圆形截面不表示复杂实际井径。"
        },
        {
          "name": "模拟传感器",
          "role": "处理",
          "do": "生成两侧有噪声的归一化间隙。",
          "effect": "观察噪声对可观测信息的影响。",
          "trap": "不包含全部仪器响应。"
        },
        {
          "name": "训练偏心率模型",
          "role": "推断",
          "do": "用80个样本拟合岭回归。",
          "effect": "从测量特征估计偏心率。",
          "trap": "该关系仅对应教学几何。"
        },
        {
          "name": "独立检验",
          "role": "验证",
          "do": "在40个独立样本统计MAE。",
          "effect": "对照真实偏心率与估计值。",
          "trap": "预测误差不能换算为固井质量结论。"
        }
      ],
      "metrics": {
        "title": "如何验证这个实验",
        "html": "<p>以圆形井眼和圆形套管建立环空几何基线。套管外径固定 140 mm；偏移为偏心率 × 同心间隙，最小间隙为同心间隙 − 偏移。按周向角计算局部间隙，以 80 个带噪两侧间隙样本训练岭回归估计偏心率，40 个独立样本评价 MAE。不模拟流变与扶正器力学。</p><div class=\"p-concept-figure\"><svg viewBox=\"0 0 685 215\" role=\"img\" aria-label=\"从两侧间隙观测估计套管偏心，再用几何真值检查误差。\" style=\"width:100%;font-family:system-ui;fill:#47685a\"><path d=\"M30 15v90M170 15v90\" stroke=\"#bda480\" stroke-width=\"14\"/><path d=\"M78 15v90M125 15v90\" stroke=\"#7e9baf\" stroke-width=\"9\"/><path d=\"M100 20v65m-5-8 5 8 5-8\" stroke=\"#309883\" fill=\"none\" stroke-width=\"2\"/><text x=\"235\" y=\"45\" font-size=\"14\">几何与载荷</text><text x=\"235\" y=\"70\" font-size=\"12\">变化 → 响应 → 验证</text><rect x=\"10\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"86\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">截面几何</text><path d=\"M165 170h10\" stroke=\"#9db2a7\"/><rect x=\"177\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"253\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">间隙传感器</text><path d=\"M332 170h10\" stroke=\"#9db2a7\"/><rect x=\"344\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"420\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">偏心率学习</text><path d=\"M499 170h10\" stroke=\"#9db2a7\"/><rect x=\"511\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"587\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">独立验证</text></svg></div>"
      },
