          "name": "评估报警结果",
          "role": "验证",
          "do": "与预设异常标签比较，并改变噪声、阈值或连续点数。",
          "effect": "查看逐点 F1、误报数与漏检数。",
          "trap": "真实维护效益还取决于提前量与检修证据。"
        }
