          "effect": "形成用于代理模型拟合的数据。",
          "trap": "样本关系仅供教学。"
        },
        {
          "name": "拟合响应曲面",
          "role": "处理",
          "do": "用二次特征回归构造代理模型。",
          "effect": "绘制钻速响应热图。",
          "trap": "曲面平滑不证明物理正确。"
        },
        {
          "name": "设置功率限制",
          "role": "推断",
          "do": "排除超出功率代理上限的参数网格。",
          "effect": "显示可行区如何缩小。",
          "trap": "约束是演示指数，不是设备额定功率。"
        },
        {
          "name": "比较推荐与当前",
          "role": "验证",
          "do": "在可行网格中最大化归一化响应减资源惩罚。",
          "effect": "解释推荐点及约束代价。",
          "trap": "网格最优不等于连续全局最优。"
        }
      ],
