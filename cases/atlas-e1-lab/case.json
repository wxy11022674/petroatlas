      "steps": [
        {
          "name": "构造施工试验",
          "role": "输入",
          "do": "在排量与加砂强度参数域内生成 72 个带噪声的教学试验点。",
          "effect": "为代理拟合提供覆盖参数域的样本。",
          "trap": "本例收益是人为定义的响应，不是产能预测。"
        },
        {
          "name": "拟合二次代理",
          "role": "处理",
          "do": "用线性项、平方项与交叉项拟合响应面。",
          "effect": "热力图把两个控制量的共同影响展开。",
          "trap": "样本噪声会移动表观最优点。"
        },
        {
          "name": "施加压力预算",
          "role": "推断",
          "do": "对每个候选组合计算教学约束代价，屏蔽超预算区域。",
          "effect": "可行域与高收益区域可以直接比较。",
          "trap": "压力代理并非井筒水力学计算。"
        },
        {
          "name": "比较可行方案",
          "role": "验证",
          "do": "枚举 31×31 网格，标出综合目标最高的可行点并对照当前点。",
          "effect": "观察预算与资源惩罚权重如何改变推荐。",
          "trap": "网格最优只针对本次参数域和简化代理。"
        }
      ],
