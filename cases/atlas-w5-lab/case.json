        ],
        [
          "运行位置",
          "浏览器"
        ]
      ],
      "steps": [
        {
          "name": "遮挡已知观测",
          "role": "输入",
          "do": "隐藏连续一段GR观测，保留辅助曲线。",
          "effect": "建立可检验的缺失场景。",
          "trap": "隐藏真值不能参与拟合。"
        },
        {
          "name": "建立训练对",
          "role": "处理",
          "do": "用未缺失位置的辅助曲线与GR组成训练集。",
          "effect": "学习两条曲线的关系。",
          "trap": "真实曲线相关性可能随岩性变化。"
        },
        {
          "name": "比较重建方法",
          "role": "推断",
          "do": "切换岭回归、线性和最近邻插值。",
          "effect": "观察辅助信息是否恢复缺口内部变化。",
          "trap": "模型可能产生跨层错误迁移。"
        },
        {
          "name": "遮挡区验收",
          "role": "验证",
          "do": "只对缺失段计算RMSE并比较插值基线。",
          "effect": "避免保留区域稀释修复误差。",
          "trap": "教学相关性不保证跨井有效。"
        }
      ],
      "metrics": {
        "title": "如何验证这个实验",
        "html": "<p>遮挡一段已知曲线，以缺失区之外的样本拟合辅助曲线到目标曲线的岭回归，也可切换为线性和最近邻插值。仅在遮挡区内与被隐藏的观测值计算 RMSE，并与线性插值基线比较。隐藏真值不参与重建。</p><div class=\"p-concept-figure\"><svg viewBox=\"0 0 685 215\" role=\"img\" aria-label=\"缺失段看不见的变化，能否从另一条可观测曲线中学出来？\" style=\"width:100%;font-family:system-ui;fill:#47685a\"><polyline points=\"15,59 18,61 21,63 24,65 27,67 30,69 33,71 36,59 39,61 42,63 45,65 48,67 51,69 54,71 57,59 60,61 63,63 66,65 69,42 72,44 75,46 78,34 81,36 84,38 87,40 90,42 93,44 96,46 99,34 102,36 105,38 108,40 111,42 114,44 117,46 120,34 123,61 126,63 129,65 132,67 135,69 138,71 141,59 144,61 147,63 150,65 153,67 156,69 159,71 162,59 165,61 168,63 171,65 174,67 177,44 180,46 183,34 186,36 189,38 192,40 195,42 198,44 201,46 204,34 207,36 210,38\" fill=\"none\" stroke=\"#3a927c\" stroke-width=\"2\"/><path d=\"M220 57h40m-7-5 7 5-7 5\" stroke=\"#7a9c8c\"/><text x=\"280\" y=\"50\" font-size=\"14\">从观测到解释</text><text x=\"280\" y=\"75\" font-size=\"12\">保留误差与判断依据</text><rect x=\"10\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"86\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">缺失曲线</text><path d=\"M165 170h10\" stroke=\"#9db2a7\"/><rect x=\"177\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"253\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">辅助观测</text><path d=\"M332 170h10\" stroke=\"#9db2a7\"/><rect x=\"344\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"420\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">回归重建</text><path d=\"M499 170h10\" stroke=\"#9db2a7\"/><rect x=\"511\" y=\"143\" width=\"153\" height=\"55\" rx=\"7\" fill=\"#edf4ef\" stroke=\"#d4e3d9\"/><text x=\"587\" y=\"175\" text-anchor=\"middle\" font-size=\"12\">遮挡验证</text></svg></div>"
      },
