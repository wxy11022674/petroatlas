      "steps": [
        {
          "name": "设计配方样本",
          "role": "输入",
          "do": "在两个浓度轴上生成 72 个带噪声的合成驱替样本。",
          "effect": "为教学响应面提供拟合数据。",
          "trap": "界面百分数是合成驱替指标，不是真实岩心驱替效率。"
        },
        {
          "name": "建立代理响应",
          "role": "处理",
          "do": "拟合浓度一次项、平方项和交互项。",
          "effect": "二维色阶揭示高响应区和边际收益变化。",
          "trap": "样本范围外的曲面延伸不可信。"
        },
        {
          "name": "加入费用限制",
          "role": "推断",
          "do": "计算候选组合的教学成本代理并裁剪可行域。",
          "effect": "昂贵的高响应配方可能被排除。",
          "trap": "实际成本还包含配伍、处理和注入等费用。"
        },
        {
          "name": "搜索与敏感性比较",
          "role": "验证",
          "do": "在 31×31 网格中最大化综合目标，再改变预算或惩罚权重观察推荐点。",
          "effect": "说明配方选择不是单纯把浓度调到最大。",
          "trap": "推荐仅用于本次合成实验。"
        }
      ],
