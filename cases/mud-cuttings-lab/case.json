=\"343\" cy=\"313\" r=\"1.0\" fill=\"#b29664\" opacity=\".35\"/>\n<rect x=\"30\" y=\"305\" width=\"344\" height=\"90\" fill=\"#d6e1e2\"/><rect x=\"30\" y=\"305\" width=\"344\" height=\"90\" fill=\"url(#cb-shale)\"/>\n<rect x=\"30\" y=\"395\" width=\"344\" height=\"103\" fill=\"#e0e7d7\"/><rect x=\"30\" y=\"395\" width=\"344\" height=\"103\" fill=\"url(#cb-lime)\"/>\n<path d=\"M28 214H377\" stroke=\"#739386\" stroke-width=\"2\"/><text x=\"44\" y=\"237\" font-size=\"10\" fill=\"#8b805f\">概念地层剖面</text><text x=\"45\" y=\"287\" fill=\"#998666\" font-size=\"11\">层段 A</text><text x=\"45\" y=\"378\" fill=\"#7c9399\" font-size=\"11\">层段 B</text><text x=\"45\" y=\"480\" fill=\"#8a9a7e\" font-size=\"11\">层段 C</text>\n<!-- Derrick, borehole, drillpipe and bit. -->\n<path d=\"M145 206L185 73L226 206M160 155H211M170 120H200M145 206L211 155 170 120 193 82M225 206L160 155 200 120 178 82\" fill=\"none\" stroke=\"#77958d\" stroke-width=\"3\"/>\n<rect x=\"137\" y=\"204\" width=\"97\" height=\"11\" rx=\"2\" fill=\"#52786c\"/>\n<path d=\"M151 216V459Q151 491 185 492Q219 491 219 459V216\" fill=\"#eef7f2\" stroke=\"#a5bbae\" stroke-width=\"2\"/>\n<rect x=\"175\" y=\"144\" width=\"20\" height=\"320\" fill=\"#899c9a\"/><rect x=\"179\" y=\"144\" width=\"12\" height=\"320\" fill=\"#d7edf1\"/>\n<path d=\"M169 464h32l6 15-12 10h-21l-12-10Z\" fill=\"#4c6e69\"/><path d=\"M170 479l7 9m5-9 5 11m6-11 6 8\" stroke=\"#b8c9c2\" stroke-width=\"3\"/>\n<path d=\"M86 184H126V136H185V459\" fill=\"none\" stroke=\"#c1dce8\" stroke-width=\"9\"/><path class=\"cb-flow\" d=\"M86 184H126V136H185V459\" fill=\"none\" stroke=\"#3b88b3\" stroke-width=\"3\"/>\n<path d=\"M198 477Q210 473 210 454V202H452L477 221M172 477Q160 470 160 450V222\" fill=\"none\" stroke=\"#c5e4d5\" stroke-width=\"8\"/><path class=\"cb-flow\" d=\"M198 477Q210 473 210 454V202H452L477 221M172 477Q160 470 160 450V222\" fill=\"none\" stroke=\"#2d9b7a\" stroke-width=\"3\"/>\n<rect x=\"46\" y=\"169\" width=\"43\" height=\"29\" rx=\"5\" fill=\"#e3edf2\" stroke=\"#6894aa\"/><circle cx=\"67\" cy=\"183\" r=\"8\" fill=\"none\" stroke=\"#6894aa\"/><text x=\"45\" y=\"158\" fill=\"#567e90\" font-size=\"11\">泥浆泵</text>\n<path d=\"M196 315H272\" fill=\"none\" stroke=\"#5b8a95\"/><text x=\"279\" y=\"311\" font-size=\"12\" fill=\"#427a92\">钻杆内部</text><text x=\"279\" y=\"329\" font-size=\"11\" fill=\"#7598a7\">钻井液下行</text>\n<path d=\"M214 365H272\" fill=\"none\" stroke=\"#5c9d82\"/><text x=\"279\" y=\"362\" font-size=\"12\" fill=\"#357e61\">环空</text><text x=\"279\" y=\"380\" font-size=\"11\" fill=\"#789887\">携屑上返</text>\n<path d=\"M205 480L263 452\" stroke=\"#7e9b8b\" fill=\"none\"/><text x=\"269\" y=\"448\" font-size=\"12\" fill=\"#4c7564\">钻头切削岩石</text><text x=\"269\" y=\"467\" font-size=\"10\" fill=\"#80968b\">产生新鲜岩屑</text>\n<path d=\"M208 275l5-4 4 4-4 4ZM207 346l5-3 3 5-5 3ZM207 410l4-5 5 4-2 4Z\" fill=\"#bc9e6e\"/>\n<!-- Shaker screen, separated mud and an indexed sample tray. -->\n<text x=\"441\" y=\"93\" font-size=\"17\" fill=\"#315d4d\" font-weight=\"600\">先分离，再保留来源</text><text x=\"441\" y=\"119\" font-size=\"12\" fill=\"#789184\">采样时刻、井深记录与样品编号一起保留</text>\n<path d=\"M458 231L609 247 600 264 450 247Z\" fill=\"#cddbd3\" stroke=\"#6d9480\"/><path d=\"M463 239L601 254\" stroke=\"#7b9b87\" stroke-dasharray=\"2 5\" stroke-width=\"3\"/>\n<path d=\"M463 257v18l12 5-12 5 12 5v16M585 269v13l12 5-12 5 12 5v15\" fill=\"none\" stroke=\"#a6b9aa\" stroke-width=\"2\"/>\n<rect x=\"447\" y=\"309\" width=\"168\" height=\"14\" rx=\"4\" fill=\"#c7dad3\"/><path class=\"cb-flow\" d=\"M500 260V302M540 264V302M580 268V302\" stroke=\"#6baaa0\" stroke-width=\"2\"/>\n<text x=\"630\" y=\"248\" font-size=\"12\" fill=\"#487962\">振动筛</text><text x=\"630\" y=\"268\" font-size=\"10\" fill=\"#8a9b8f\">筛上采集岩屑</text><text x=\"630\" y=\"313\" font-size=\"10\" fill=\"#73968a\">筛下液回处理系统</text>\n<path d=\"M605 252Q653 279 646 342\" fill=\"none\" stroke=\"#85aa94\" marker-end=\"url(#cb-arrow)\"/>\n<rect x=\"452\" y=\"351\" width=\"190\" height=\"70\" rx=\"9\" fill=\"#e9eee3\" stroke=\"#a7bca6\"/><path d=\"M477 226l7 -4 7 7 -5 6 -10 -2Z\" fill=\"#bd9c66\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M499 230l8 -4 7 7 -5 6 -10 -2Z\" fill=\"#788e91\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M521 232l9 -4 7 7 -5 6 -10 -2Z\" fill=\"#a3ae92\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M543 236l10 -4 7 7 -5 6 -10 -2Z\" fill=\"#bd9c66\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M565 238l7 -4 7 7 -5 6 -10 -2Z\" fill=\"#788e91\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M478 368l8 -4 7 7 -5 6 -10 -2Z\" fill=\"#a3ae92\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M506 380l9 -4 7 7 -5 6 -10 -2Z\" fill=\"#bd9c66\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M531 366l10 -4 7 7 -5 6 -10 -2Z\" fill=\"#788e91\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M561 379l7 -4 7 7 -5 6 -10 -2Z\" fill=\"#a3ae92\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M591 367l8 -4 7 7 -5 6 -10 -2Z\" fill=\"#bd9c66\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M618 383l9 -4 7 7 -5 6 -10 -2Z\" fill=\"#788e91\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M480 395l10 -4 7 7 -5 6 -10 -2Z\" fill=\"#a3ae92\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M521 402l7 -4 7 7 -5 6 -10 -2Z\" fill=\"#bd9c66\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M566 401l8 -4 7 7 -5 6 -10 -2Z\" fill=\"#788e91\" stroke=\"#ffffff\" stroke-width=\".7\"/><path d=\"M604 403l9 -4 7 7 -5 6 -10 -2Z\" fill=\"#a3ae92\" stroke=\"#ffffff\" stroke-width=\".7\"/>\n<rect x=\"467\" y=\"430\" width=\"161\" height=\"51\" rx=\"5\" fill=\"#fff\" stroke=\"#b8cebe\"/><text x=\"478\" y=\"449\" font-size=\"10\" fill=\"#4b7860\">样品编号　S-001（示例）</text><text x=\"478\" y=\"468\" font-size=\"10\" fill=\"#789281\">采样时间 + 校正来源井深</text>\n<text x=\"654\" y=\"376\" font-size=\"11\" fill=\"#527b65\">按规范清洗</text><text x=\"654\" y=\"395\" font-size=\"11\" fill=\"#527b65\">分样、留样</text>\n<!-- Image acquisition: controlled lighting, camera, image tensor. -->\n<text x=\"792\" y=\"93\" font-size=\"17\" fill=\"#315d4d\" font-weight=\"600\">让图像差异尽量来自样品</text><text x=\"792\" y=\"119\" font-size=\"12\" fill=\"#789184\">统一光照、背景与尺度，记录拍摄条件</text>\n<path d=\"M810 225V165H1048V225\" fill=\"none\" stroke=\"#a0b3ab\" stroke-width=\"3\"/><rect x=\"899\" y=\"151\" width=\"59\" height=\"36\" rx=\"7\" fill=\"#536d6b\"/><circle cx=\"929\" cy=\"170\" r=\"12\" fill=\"#dcebec\"/><circle cx=\"929\" cy=\"170\" r=\"7\" fill=\"#557d82\"/>\n<path d=\"M907 188L862 236M949 188L993 236\" stroke=\"#b9d4c6\" stroke-dasharray=\"4 5\"/><ellipse cx=\"928\" cy=\"246\" rx=\"68\" ry=\"16\" fill=\"#dde8df\" stroke=\"#9ebaa7\"/><path d=\"M895 243l16-9 13 11-14 10ZM934 244l15-7 13 8-15 8Z\" fill=\"#bda478\"/>\n<text x=\"790\" y=\"190\" font-size=\"10\" fill=\"#789184\">受控光源</text><text x=\"994\" y=\"190\" font-size=\"10\" fill=\"#789184\">固定相机</text>\n<path d=\"M928 268V287\" stroke=\"#659e84\" marker-end=\"url(#cb-arrow)\"/>\n<rect x=\"897\" y=\"295\" width=\"136\" height=\"136\" rx=\"8\" fill=\"#e9f2eb\" stroke=\"#afc8b5\"/><rect x=\"905\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 28%)\"/><rect x=\"915\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 41%)\"/><rect x=\"925\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 54%)\"/><rect x=\"935\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 67%)\"/><rect x=\"945\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 35%)\"/><rect x=\"955\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 48%)\"/><rect x=\"965\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 61%)\"/><rect x=\"975\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 29%)\"/><rect x=\"985\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 42%)\"/><rect x=\"995\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 55%)\"/><rect x=\"1005\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27% 68%)\"/><rect x=\"1015\" y=\"303\" width=\"9\" height=\"9\" fill=\"hsl(164 27%