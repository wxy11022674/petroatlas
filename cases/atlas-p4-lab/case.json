      "steps": [
        {
          "name": "准备评价样本",
          "role": "输入",
          "do": "生成特征与流动响应成对样本并分开训练测试。",
          "effect": "明确模型看到与未看到的数据。",
          "trap": "不同压差下的流量不能不加处理地直接比较。"
        },
        {
          "name": "拟合响应关系",
          "role": "处理",
          "do": "训练带正则化的回归基线。",
          "effect": "展示表皮代理量等特征与响应的关系。",
          "trap": "相关关系并不证明单一因素造成产量变化。"
        },
        {
          "name": "对照预测散点",
          "role": "推断",
          "do": "比较测试样本的预测值和参考值。",
          "effect": "发现系统偏高、偏低与离散误差。",
          "trap": "合成真值不是试井解释结果。"
        },
        {
          "name": "限定评价结论",
          "role": "验证",
          "do": "同时阅读误差指标和模型假设。",
          "effect": "理解模型能辅助筛查而不能直接决定补孔。",
          "trap": "真实评价需排除工况变化与储层压力影响。"
        }
      ],
